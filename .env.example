# Run ./scripts/setup.sh to generate .env with unique credentials.
# These URLs are local defaults, not public Instagram webhook URLs.
APP_URL=http://localhost:3123
ASSET_URL=http://localhost:9000/chatbotx/
S3_ENDPOINT=http://host.docker.internal:9000
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
RUSTFS_SECRET_KEY=
REALTIME_API_KEY=
REALTIME_BROADCAST_SECRET=
JAVASCRIPT_EXECUTOR_TOKEN=
# Instagram Business Login (configure these as Vercel environment variables too)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://your-vercel-domain/api/instagram/callback
LOGIN_STATE_SECRET=
REEL_CONNECTOR_URL=https://your-vercel-domain/connect/
# Optional Neon URL; SQLite requires no database account or connection URL.
REEL_FOLLOWUP_DATABASE_URL=
# Public Meta webhook receiver (server-only Vercel variables; never NEXT_PUBLIC_)
IG_WEBHOOK_ACCOUNT_ID=
IG_WEBHOOK_ACCOUNT_ALIASES=
IG_WEBHOOK_VERIFY_TOKEN=
# Optional dedicated Meta webhook signing secret; IG_APP_SECRET is also accepted.
IG_WEBHOOK_APP_SECRET=
# Optional multi-account registry for accounts authorized under this same Meta app.
# Replaces IG_WEBHOOK_ACCOUNT_ID/ALIASES when set; IDs must not overlap.
# IG_WEBHOOK_ACCOUNTS=[{"accountId":"123","aliases":["456"]}]
# Pi/Mac worker settings (separate account workspaces in one service).
REEL_STORAGE=sqlite
REEL_WEBHOOK_DELIVERY=direct
REEL_WEBHOOK_URL=https://your-vercel-domain/api/instagram/webhook
REEL_LINK_URL=https://example.com/

# Signed Pi credential/event bridge; required by the secure connector.
REEL_PI_SERVICE_URL=
REEL_PI_SERVICE_SECRET=
REEL_RESERVED_ACCOUNT_IDS=
