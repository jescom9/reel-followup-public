# Self-hosted Python worker: start from .env.pi.example on the Pi.
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
REEL_STORAGE=sqlite
REEL_WEBHOOK_DELIVERY=direct
REEL_WEBHOOK_URL=https://your-pi-host/webhook
IG_WEBHOOK_VERIFY_TOKEN=
REEL_LINK_URL=https://example.com/
REEL_CONNECTOR_URL=https://your-connector-domain/connect/
# Optional own-Meta-app connector: configure on your Vercel deployment.
IG_REDIRECT_URI=https://your-connector-domain/api/instagram/callback
LOGIN_STATE_SECRET=
REEL_PI_SERVICE_URL=https://your-pi-host/
REEL_PI_SERVICE_SECRET=
IG_WEBHOOK_APP_SECRET=
IG_WEBHOOK_ACCOUNT_ID=
IG_WEBHOOK_ACCOUNT_ALIASES=
# Optional Neon archive/queue compatibility; not needed by SQLite installations.
REEL_FOLLOWUP_DATABASE_URL=
# Optional independent account registry/migration routing.
REEL_RESERVED_ACCOUNT_IDS=
REEL_PI_ACCOUNT_IDS=
