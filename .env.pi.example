# Local SQLite is the default. Neon is opt-in.
REEL_STORAGE=sqlite
REEL_WEBHOOK_DELIVERY=direct
REEL_FOLLOWUP_DATABASE_URL=
# Your Meta automation app and authorized Instagram account.
IG_APP_ID=
IG_APP_SECRET=
# Optional legacy import: consumed into encrypted storage on startup.
IG_ACCESS_TOKEN=
IG_WEBHOOK_VERIFY_TOKEN=
# Deploy your own connector with the same Meta app; this is its /connect/ page.
REEL_CONNECTOR_URL=
# Public HTTPS URL reaching only the signed Pi webhook listener.
REEL_WEBHOOK_URL=
REEL_LINK_URL=https://example.com/

# Secure OAuth/event bridge (server-side values, never public keys).
REEL_PI_SERVICE_SECRET=
REEL_RESERVED_ACCOUNT_IDS=

# Optional operator Instagram inbox for owner-verified campaign setup by DM.
# Connect this professional account through the same app; it is then enabled as a service inbox.
REEL_CAMPAIGN_SETUP_USERNAME=
REEL_CAMPAIGN_SETUP_SIGNUP_URL=https://reelfollowups.app/connect/

# Optional admin inspection: verified Instagram account IDs, never usernames.
# Admin access is checked on the Pi and does not grant editing, deletion or billing access to other accounts.
REEL_ADMIN_ACCOUNT_IDS=
# Owner-verified operational alert recipient. They must send alerts to the setup inbox.
REEL_ALERT_USERNAME=
# Dedicated forced-command SSH upload destination for encrypted snapshots.
REEL_BACKUP_SSH_HOST=
REEL_BACKUP_SSH_USER=pi
# Primary's HTTPS /host/health endpoint for independent standby probes.
REEL_STANDBY_HEALTH_URL=
